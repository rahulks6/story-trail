# KATKEE backend configuration.
# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
PORT=4000

PGHOST=localhost
PGPORT=5432
PGDATABASE=katkee_dev
PGUSER=katkee
PGPASSWORD=change_me

# HS256 signing secret for access/refresh tokens. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Media storage (see src/modules/media/storage.ts).
#   local  development/tests only: files under MEDIA_STORAGE_ROOT (default <backend>/data/media)
#   s3     production (required there): MEDIA_S3_BUCKET in AWS_REGION, credentials from the AWS chain
MEDIA_STORE=local
MEDIA_STORAGE_ROOT=
MEDIA_S3_BUCKET=
# Delivery CDN (required in production): CloudFront domain + trusted key group key pair.
# CLOUDFRONT_PRIVATE_KEY is the PEM (or base64 of it) from your secret store, never committed.
MEDIA_CDN_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
# Signed URL lifetime; URLs are valid for one to two of these (rounded for caching).
MEDIA_URL_TTL_SECONDS=3600
# Processing queue: postgres (default) or sqs (adds wake-up messages; set MEDIA_SQS_QUEUE_URL).
MEDIA_QUEUE=postgres
MEDIA_SQS_QUEUE_URL=
# Development convenience: process uploads inside the API process (refused in production;
# there run `npm run worker` as its own service). Video processing needs ffmpeg/ffprobe on PATH.
MEDIA_WORKER_IN_PROCESS=true
# Upload/processing limits (defaults shown).
MEDIA_UPLOAD_PART_BYTES=8388608
MEDIA_UPLOADS_PER_HOUR=60
MEDIA_MAX_OPEN_UPLOADS=5
MEDIA_MAX_VIDEO_SECONDS=60

# Retention (days unless noted; defaults shown). The worker runs these hourly.
RETENTION_ENABLED=true
RETENTION_UNUSED_MEDIA_HOURS=48
RETENTION_DELETED_STORY_DAYS=30
RETENTION_MODERATION_EVIDENCE_DAYS=180
RETENTION_DELETED_ACCOUNT_DAYS=30
RETENTION_ORIGINAL_MEDIA_DAYS=30
RETENTION_SECURITY_EVENT_DAYS=400

# How long a published Story stays active (spec section 29: 24h in
# production). Defaults to 86400 if unset.
STORY_TTL_SECONDS=

# Phase 10: in-memory, single-process rate limiting (see
# src/http/rateLimiter.ts for why in-memory is the deliberate tradeoff
# here). Auth applies to signup/login/refresh combined, per IP; global
# applies to every request, per IP. Defaults: 10 auth requests per 15
# minutes, 600 requests per minute overall.
RATE_LIMIT_AUTH_WINDOW_MS=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_GLOBAL_WINDOW_MS=
RATE_LIMIT_GLOBAL_MAX=

# Additive admin/ads options. Existing consumer functionality does not require these flags.
ADMIN_CONSOLE_ENABLED=false
ADMIN_ORIGIN=http://localhost:4000
ADS_ENABLED=false
SPONSORED_STORIES_ENABLED=false
AD_REPORTING_ENABLED=false

# Optional provider sign-in. See docs/PROVIDER_AUTH_ROLLOUT.md before enabling.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_IDS=
PHONE_AUTH_ENABLED=false
PHONE_AUTH_COUNTRIES=
PHONE_IDENTITY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_OTP_CODE_LENGTH=6
PHONE_OTP_DAILY_LIMIT=100

# --- Account security (Phase 1, Oct 2026) ---
# Email delivery for password reset codes and security alerts.
#   ses      Amazon SES v2 (required in production; uses the standard AWS credential chain)
#   log      development only: prints messages to stdout (refused when NODE_ENV=production)
#   memory   tests
#   disabled no email (reset requests still answer 202, nothing is sent)
EMAIL_PROVIDER=log
EMAIL_FROM=
AWS_REGION=ap-south-1
# Deep link opened from the reset email; ?email=&code= is appended.
PASSWORD_RESET_LINK=katkee://reset-password
# Shared (PostgreSQL-backed) per-network budgets per hour; defaults shown.
RATE_LIMIT_SIGNUP_PER_HOUR=
RATE_LIMIT_RESET_REQUESTS_PER_HOUR=
RATE_LIMIT_RESET_VERIFY_PER_HOUR=
# Admin console sign-in attempts per network address per 15 minutes (per-account limits are separate).
RATE_LIMIT_ADMIN_LOGIN_PER_IP=

# --- Admin console two-step verification ---
# Required whenever ADMIN_CONSOLE_ENABLED=true: 32 random bytes as 64 hex characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes every enrolled authenticator unusable (admins re-enroll via a Super Admin reset).
ADMIN_MFA_ENCRYPTION_KEY=
# TOTP is mandatory for every admin; only a non-production environment may set this to false.
ADMIN_MFA_REQUIRED=true
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_ABSOLUTE_MINUTES=480
