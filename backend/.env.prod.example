# For docker-compose.prod.yml — copy to `.env` next to it on your VPS:
#   cp .env.prod.example .env
# This file is read by `docker compose` itself for ${VAR} substitution; it
# is never baked into the image (see .dockerignore) and the values become
# real container environment variables via docker-compose.prod.yml's
# `environment:` blocks — the app never reads this file directly.

POSTGRES_PASSWORD=

# Generate each of these with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They must be different from each other and at least 32 characters —
# config/env.ts refuses to start otherwise (see backend/README.md's
# Phase 11 section).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The domain Caddy requests a real TLS certificate for — point its DNS A
# record at your VPS's IP before starting the stack, e.g. api.yourapp.com
DOMAIN=

# Amazon SES sender (verified identity in ap-south-1) for password reset codes and
# security alerts. Production refuses to start without EMAIL_PROVIDER=ses.
EMAIL_FROM=
AWS_REGION=ap-south-1

# Admin console (only if ADMIN_CONSOLE_ENABLED=true): 32 random bytes, 64 hex characters.
ADMIN_MFA_ENCRYPTION_KEY=

# Media (required): private S3 bucket in AWS_REGION (Block Public Access on), and a
# CloudFront distribution reading it through origin access control with a trusted key group.
MEDIA_S3_BUCKET=
MEDIA_CDN_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# PEM private key of the key group's public key (or base64 of the PEM). Keep it in a secret store.
CLOUDFRONT_PRIVATE_KEY=
# Optional: SQS wake-ups for the media worker (MEDIA_QUEUE=sqs).
MEDIA_QUEUE=postgres
MEDIA_SQS_QUEUE_URL=

# Push notifications (sent by the worker). The app registers Firebase Cloud Messaging
# tokens on Android and iOS (FCM reaches iPhones through APNs: upload the APNs auth key
# in the Firebase console). Leave empty to run without push; the app still updates
# live over the realtime connection while open. Notification text never includes
# message content. Keep these in a secret store, never in source.
# FCM: the Firebase service account JSON (or base64 of it) with the
# "Firebase Cloud Messaging API Admin" role.
FCM_SERVICE_ACCOUNT_JSON=
# Direct APNs (only for clients that register raw APNs tokens; the shipped app uses FCM):
# token-based auth key (.p8, or base64 of it). All four or none.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
# production (App Store/TestFlight builds) or sandbox (development builds).
APNS_ENVIRONMENT=production
# Link safety: Google Safe Browsing API key (Lookup API v4), from the secret store.
SAFE_BROWSING_API_KEY=
# Product analytics: the day boundary for DAU/WAU/MAU and retention. Set once before launch.
ANALYTICS_TIME_ZONE=UTC
ANALYTICS_RAW_RETENTION_DAYS=90
# Only when not running on AWS with an instance/task role: an IAM user limited to the
# bucket (s3:PutObject/GetObject/DeleteObject/ListMultipartUploadParts/AbortMultipartUpload),
# SES SendEmail and, if used, the SQS queue.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
