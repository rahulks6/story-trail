# For docker-compose.prod.yml — copy to `.env` next to it on your VPS:
#   cp .env.prod.example .env
# This file is read by `docker compose` itself for ${VAR} substitution; it
# is never baked into the image (see .dockerignore) and the values become
# real container environment variables via docker-compose.prod.yml's
# `environment:` blocks — the app never reads this file directly.

POSTGRES_PASSWORD=

# Generate each of these with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# They must be different from each other and at least 32 characters —
# config/env.ts refuses to start otherwise (see backend/README.md's
# Phase 11 section).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# The domain Caddy requests a real TLS certificate for — point its DNS A
# record at your VPS's IP before starting the stack, e.g. api.yourapp.com
DOMAIN=
