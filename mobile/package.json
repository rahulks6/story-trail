{
  "name": "@katkee/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "KATKEE — Story-first social network. React Native app (Phase 1-11: full feature set through moderation + production hardening — see README.md).",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "check:release": "node scripts/check-release.cjs",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/index.android.bundle --assets-dest build/android",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/main.jsbundle --assets-dest build/ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-clipboard/clipboard": "^1.14.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-google-signin/google-signin": "13.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "react": "18.3.1",
    "react-native": "0.75.4",
    "react-native-fs": "2.20.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-keychain": "9.2.2",
    "react-native-safe-area-context": "^4.11.0",
    "react-native-screens": "^3.34.0",
    "react-native-svg": "15.8.0",
    "react-native-video": "^6.7.0",
    "react-native-vision-camera": "^4.6.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native-community/cli": "14.1.0",
    "@react-native-community/cli-platform-android": "14.1.0",
    "@react-native-community/cli-platform-ios": "14.1.0",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@react-native/typescript-config": "^0.75.4",
    "@types/react": "^18.3.5",
    "typescript": "^5.6.0"
  }
}
