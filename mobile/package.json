{
  "name": "@katkee/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "KATKEE \u2014 Story-first social network. React Native app (Phase 1-11: full feature set through moderation + production hardening \u2014 see README.md).",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "check:release": "node scripts/check-release.cjs",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/index.android.bundle --assets-dest build/android",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/main.jsbundle --assets-dest build/ios"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.40.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-image-picker": "8.2.1",
    "react-native-keychain": "10.0.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-video": "6.19.3",
    "react-native-vision-camera": "5.2.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "19.2.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
