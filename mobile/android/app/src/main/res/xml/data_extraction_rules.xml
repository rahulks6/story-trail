<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied by cloud backup or to a new phone: sign-in keys live in the Android
     Keystore and don't move, so a copied app would arrive half signed in. People sign in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
