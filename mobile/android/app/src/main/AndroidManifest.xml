<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Like confirmation (Vibration.vibrate in StoryFeed); without it Android throws a SecurityException. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 13+: asked in context (first visit to Messages or Activity), never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Approximate location only (Nearby Stories and the location sticker), never precise:
         the Privacy Policy says so, and iOS asks with reduced accuracy too. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Contacts on Katkee: read only, asked after an explainer and only when the person taps
         Continue. Emails and numbers are hashed on the phone; nothing is ever written back. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove" />
    <!-- react-native-fs declares this; Katkee keeps its files in its own storage only, and the
         photo picker needs no storage permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- The merger otherwise implies READ from the WRITE above; nothing reads shared storage. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Cleartext is allowed only in debuggable builds (the React Native Gradle
         plugin sets the placeholder); release builds are HTTPS-only. -->
    <application android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:fullBackupContent="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- katkee://user/<username>, katkee://story/<id> (Share sheet), katkee://reset-password (reset email),
             katkee://conversation/<id>, katkee://activity, katkee://home and katkee://verification
             (push notifications), katkee://invite/<code> (the invite page's button). -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="katkee" android:host="user" />
            <data android:scheme="katkee" android:host="story" />
            <data android:scheme="katkee" android:host="reset-password" />
            <data android:scheme="katkee" android:host="conversation" />
            <data android:scheme="katkee" android:host="activity" />
            <data android:scheme="katkee" android:host="follow-requests" />
            <data android:scheme="katkee" android:host="home" />
            <data android:scheme="katkee" android:host="verification" />
            <data android:scheme="katkee" android:host="invite" />
        </intent-filter>
        <!-- Shared profiles, Stories and invites: https://katkee.com/u/<username>, /s/<id> and
             /i/<code> (App Links).
             Android checks katkee.com/.well-known/assetlinks.json for this app's signing key, then
             opens these links here without asking; anywhere else they show the website's
             "Open in Katkee" page. Only katkee.com: www redirects, and a host that fails
             verification would fail all of them on Android 11 and older. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
            <data android:host="katkee.com" />
            <data android:pathPrefix="/u/" />
            <data android:pathPrefix="/s/" />
            <data android:pathPrefix="/i/" />
        </intent-filter>
      </activity>
      <!-- Notifications drawn by Firebase while the app is in the background use this
           status-bar icon (shape only, tinted). The default channel and colour come from
           firebase.json, which @react-native-firebase/messaging merges into the manifest. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_notification" />
      <!-- emoji2 would otherwise start EmojiCompat with the downloadable font before
           MainApplication.onCreate, and the first configuration wins. The provider stays for
           androidx.startup's other initialisers. -->
      <provider
        android:name="androidx.startup.InitializationProvider"
        android:authorities="${applicationId}.androidx-startup"
        android:exported="false"
        tools:node="merge">
        <meta-data
          android:name="androidx.emoji2.text.EmojiCompatInitializer"
          tools:node="remove" />
      </provider>
    </application>
</manifest>
